{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "electron"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.mts",
    "src/utility/**/*.ts",
    "src/shared/**/*.ts",
    "src/server/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/utility/fake-agent.ts"]
}
