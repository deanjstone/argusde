{
  "name": "argusde",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal, full-control coding-agent desktop client.",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build && tsc -p tsconfig.node.json --outDir dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.web.json",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "pnpm run build && bin/launch-linux.sh",
    "package": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "cc.myargus.argusde",
    "productName": "ArgusDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
