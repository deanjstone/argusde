# pnpm's default for this flipped between major versions (false through pnpm 9,
# true from 10). `pnpm test` depends on it: the `pretest` hook is what
# typechecks and builds before vitest runs, so losing it would leave both local
# runs and CI testing a stale dist while still reporting green. Pinned rather
# than inherited.
enable-pre-post-scripts=true
